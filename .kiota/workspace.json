{
  "version": "1.0.0",
  "clients": {
    "CatalogClient": {
      "language": "CSharp",
      "typeAccessModifier": "Public",
      "structuredMimeTypes": [
        "application/json",
        "text/plain;q=0.9",
        "application/x-www-form-urlencoded;q=0.2",
        "multipart/form-data;q=0.1"
      ],
      "clientNamespaceName": "Catalog.SDK",
      "usesBackingStore": false,
      "includeAdditionalData": true,
      "excludeBackwardCompatible": false,
      "disabledValidationRules": [],
      "descriptionLocation": "./src/Catalog.API/Catalog.API_v2.json",
      "includePatterns": [
        "/",
        "/api",
        "/api/catalog",
        "/api/catalog/catalogbrands",
        "/api/catalog/catalogtypes",
        "/api/catalog/items",
        "/api/catalog/items/by",
        "/api/catalog/items/withsemanticrelevance",
        "/api/catalog/items/{id}",
        "/api/catalog/items/{id}/pic"
      ],
      "excludePatterns": [],
      "allowedExternalOrigins": [],
      "outputPath": "./src/Catalog.SDK"
    }
  },
  "plugins": {}
}