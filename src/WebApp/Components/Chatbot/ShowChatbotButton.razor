@inject NavigationManager Nav
@inject Microsoft.FeatureManagement.IFeatureManagerSnapshot FeatureManager
@inject Microsoft.Extensions.Logging.ILogger<ShowChatbotButton> Logger;

@if (chatbotEnabled)
{
    <a class="show-chatbot" href="@Nav.GetUriWithQueryParameter("chat", true)" title="Show chatbot"></a>
}

@if (ShowChat)
{
    <Chatbot />
}

@code {
    [SupplyParameterFromQuery(Name = "chat")]
    public bool ShowChat { get; set; }

    private bool chatbotEnabled;

    protected override async Task OnParametersSetAsync()
    {
        ReleaseContext releaseContext = new ReleaseContext
        {
            Ring = DeploymentRing.EarlyAdopters,
            Region = "WestEurope"
        };
        Logger.LogError($"Razor: Evaluating feature 'Chatbot' for ring '{releaseContext.Ring}' in region '{releaseContext.Region}'");
        chatbotEnabled = await FeatureManager.IsEnabledAsync("Chatbot", releaseContext);
    }
}
