@inject NavigationManager Nav
@inject Microsoft.FeatureManagement.IFeatureManagerSnapshot FeatureManager

@if (chatbotEnabled)
{
    <a class="show-chatbot" href="@Nav.GetUriWithQueryParameter("chat", true)" title="Show chatbot"></a>
}

@if (ShowChat)
{
    <Chatbot />
}

@code {
    [SupplyParameterFromQuery(Name = "chat")]
    public bool ShowChat { get; set; }

    private bool chatbotEnabled;

    protected override async Task OnParametersSetAsync()
    {
        chatbotEnabled = await FeatureManager.IsEnabledAsync("Chatbot");
    }
}
